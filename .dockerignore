# Build context for camenduru/vrminstanthmr.
#
# Kept: app/, scripts/, vrm_models/, web sources, requirements.txt.
# Everything the image needs at runtime is either here or fetched and pinned
# by the Dockerfile; nothing is fetched when the container runs.

# ---- local / generated state ----------------------------------------------
.venv/
venv/
env/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.git/
.gitignore
.cache/
.freebuff/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# ---- frontend ------------------------------------------------------------
# dist is rebuilt in the node stage; a stale one must never be copied in.
web/node_modules/
web/dist/
web/.vite/
web/test/
npm-debug.log*

# ---- media ---------------------------------------------------------------
# Clips are mounted at run time (-v "$PWD/videos:/app/videos") and uploaded
# through the page; a test clip must never be baked into the published image.
# The Dockerfile creates an empty /app/videos, so the app still works without
# the mount.
videos/

# ---- reference projects --------------------------------------------------
# `feet/` and `filters/` are the upstream reference implementations this app's
# retargeter was ported from. They are documentation, never imported at
# runtime, and together they are ~212 MB of build context.
feet/
filters/
tests/

# ---- docker ---------------------------------------------------------------
Dockerfile
.dockerignore
